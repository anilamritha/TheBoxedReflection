{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/show", "destination": "/show.html" },
    { "source": "/projection", "destination": "/show.html" }
  ],
  "headers": [
    {
      "source": "/p5.min.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
